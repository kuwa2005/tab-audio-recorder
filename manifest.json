{
  "manifest_version": 3,
  "name": "Tab Audio Recorder",
  "version": "1.0.0",
  "description": "タブの音声を録音し、WebMファイルとして保存する拡張機能",
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "tabCapture",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/normal/icon16.png",
      "48": "icons/normal/icon48.png",
      "128": "icons/normal/icon128.png"
    }
  },
  "icons": {
    "16": "icons/normal/icon16.png",
    "48": "icons/normal/icon48.png",
    "128": "icons/normal/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
